            "targets": [
                {
                    "datasource": {
                        "type": "loki",
                        "uid": "loki"
                    },
                    "editorMode": "builder",
                    "expr": "{app=~\"nestjs-backend|nestjs-worker\"}",
                    "queryType": "range",
                    "refId": "A"
                }
            ],
            "title": "Application Logs",
            "type": "logs"
        }
